@Service
public class inventoryService{

private RestClient restClient;

public InventoryService(RestClient.Builder builder){
 this.restClient=builder.url("http://localhost:8080").build();
}

@retry(name="inventoryService")
@CircuitBreaker(name="inventoryService" fallBack="fallbackInventoryService")
public Boolean isAvailable(String vin){
 return restClient.get().uri("/api/inventory/{vin}/availability",vin).retrieve().Boolean(Body.class);
}

public String fallbackInventoryService(Exception e, String Vin){
 thrrow new VehicleUnavailableException("Vehicle not available"+vin);
}

}
